local fs = require("@lune/fs")
local function read(path) return fs.readFile(path) end
local function contains(source, needle, message)
    assert(string.find(source, needle, 1, true), message or ("missing: " .. needle))
end

local catalog = read("ui/presentation/Catalog.lua")
for _, field in ipairs({
    "worldRenderer", "nameLabel", "boxes", "chams", "names", "health", "weapon",
    "chamsExcludeAccessories", "chamsPerPart", "chamsColor", "outlineColor",
}) do
    contains(catalog, "preview." .. field, "Preview model must publish " .. field)
end
contains(catalog, "parent = option.parent", "Catalog must retain suboption ownership")
contains(catalog, "placement = option.placement", "Catalog must publish renderer-neutral control placement")
contains(catalog, 'treatment = "grid"', "Catalog must infer toggle-grid section treatment")
contains(catalog, '{ id = "colors", label = "ESP Colors" }', "Preview model must publish its available views")

local contracts = read("ui/src/contracts.ts")
contains(contracts, 'readonly worldRenderer?: "limn" | "native";')
contains(contracts, "readonly parent?: string;")
contains(contracts, 'readonly placement?: "grid" | "details" | "audience";')
contains(contracts, 'readonly treatment?: "card" | "list" | "plain" | "grid" | "style";')
contains(contracts, 'readonly views?: readonly { readonly id: "preview" | "colors"; readonly label: string }[];')
contains(contracts, "readonly chamsTransparency?: number;")
contains(contracts, "readonly outlineColor?: Color3;")
contains(contracts, "readonly chamsPerPart?: boolean;")

local preview = read("ui/src/preview/ViewportDummy.tsx")
contains(preview, "previewRef.current = preview", "Projection callback must observe the current preview publisher")
contains(preview, "UniversalHubPreviewChams")
contains(preview, "UniversalHubPreviewHitboxes")
contains(preview, "UniversalHubPreviewLabels")
contains(preview, "72 HP")
local dist = read("ui/dist/Menu.lua")
contains(dist, "UniversalHubPreviewLabels")
contains(preview, 'new Instance("SelectionBox")')
contains(preview, "SurfaceTransparency = 1", "Preview hitboxes must be stroke-only")
contains(preview, "preview.boxes !== true", "Toggling Hitboxes off must tear down the outline overlay")
assert(not string.find(preview, "_ChamsOutline", 1, true), "Preview hitboxes must not use a 3D outline shell")
contains(preview, "previewRef.current?.publish?.(undefined)", "Disabled preview must not own a RenderStepped connection")
contains(preview, "current?.publish === undefined")
contains(preview, "accessory && current.worldRenderer !== \"native\"", "Native projection must preserve accessory ownership")
assert(not string.find(preview, "NativePreviewChams", 1, true), "Preview must not maintain a second Chams renderer")
contains(preview, "Drag to rotate")
contains(preview, "UserInputService.InputChanged.Connect", "Rotation listeners must be gesture-scoped")

local visuals = read("ui/src/visuals/VisualsPage.tsx")
contains(visuals, 'section.treatment === "grid"', "Visuals must select the grid by treatment, not section id")
contains(visuals, 'section.treatment === "style"', "Style selector must come from treatment, not worldRenderer id")
contains(visuals, 'control.placement === "details"', "Details popover must key off placement, not chams id")
contains(visuals, 'control.placement === "audience"', "Audience multi-select must key off placement, not showEnemies")
contains(visuals, "closeOnOutsidePress", "Chams settings must use Prism click-away dismissal")
contains(visuals, "ESP PREVIEW")
contains(visuals, "style={style?.controls[0]}", "Style selector must live in the preview header")
contains(visuals, "audience={audience}", "Multi-select audience control must live with the preview")
contains(visuals, 'text="VISIBILITY"', "World ESP membership control must be labeled Visibility")
assert(not string.find(visuals, 'text="AUDIENCE"', 1, true), "Audience must not remain as the visible label")
assert(not string.find(visuals, 'control.id === "showEnemies"', 1, true), "Audience must not hardcode showEnemies")
assert(not string.find(visuals, 'control.id === "chams"', 1, true), "Details must not hardcode chams")
contains(visuals, "Enable a visual to preview", "zero-option preview must not mount the 3D rig")
contains(visuals, "hasDetails ? -42 : -10", "A tile with details must reserve the action slot")
contains(visuals, "position={new UDim2(1, -10, 0.5, 0)}", "Details trigger must sit to the right of its toggle")
contains(visuals, "page.views", "Visuals must expose descriptor-driven Preview / ESP Colors views")
contains(visuals, "function Colors", "Color customization must live on its dedicated view")
contains(visuals, "alphaEnabled={fill}", "Only Fill may expose alpha")
assert(not string.find(visuals, 'text="COLORS"', 1, true), "The old inline Colors row must not remain above the preview")
contains(visuals, "Position={UDim2.fromOffset(0, 84)}", "Preview must retain breathing room below its selectors")

print("native-renderer-preview-contracts-ok")
