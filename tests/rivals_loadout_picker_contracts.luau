local fs = require("@lune/fs")
local source = fs.readFile("games/rivals/Adapter.lua")

assert(source:find('local TaskPolicy = importDependency("games/rivals/TaskPolicy", "./TaskPolicy")', 1, true), "loadout picker must import the combat-task policy it calls")
assert(source:find('PickWeaponsPage.OpenChanged:Connect', 1, true), "loadout picker must wake from the native open signal")
assert(source:find('PageFrame:GetPropertyChangedSignal("Visible")', 1, true), "loadout picker must wake from native page visibility")
assert(source:find('if not counterLoadoutReady(opponentFighter) then', 1, true), "task loadouts must wait while the opponent still has native pick permission")
assert(source:find('self.taskDebug.loadoutStage = "waiting-opponent-loadout"', 1, true), "the opponent-loadout wait must be observable")
assert(source:find('local useCounter = TaskCounterPolicy.shouldSelectSpray(opponentItems)', 1, true), "pre-round Spray selection must cover defensive opponent loadouts")
assert(source:find('self.taskDebug.loadoutStage = useCounter and "selecting-counter" or "selecting-default"', 1, true), "the native readiness transition must fall through to an aggressive default when no counter is needed")
assert(source:find('pcall(buttons.SwitchItemsRequest, buttons)', 1, true), "task automation must use the native Switch Weapons controller method")
assert(source:find('buttons.SwitchItemsFrame.Visible', 1, true), "task automation must respect native Switch Weapons visibility")
assert(source:find('buttons.Updated:Connect', 1, true), "task automation must wake when the native Switch Weapons control becomes available")
assert(source:find('if not buttons.SwitchItemsFrame.Visible or not buttons.SwitchItemsBackgroundOn.Visible then', 1, true), "native Switch Weapons availability must be the picker-open boundary")
assert(source:find('loadoutOpenRequested = false\n            return', 1, true), "closing the native switch window must re-arm the next round")
assert(source:find('self.taskDebug.loadoutStage = "opening-picker"', 1, true), "picker opening must be observable through the task debug surface")
assert(not source:find('taskCounterPolicy:update(opponentItems)', 1, true), "inventory presence must not activate combat counter switching")
assert(source:find('PickWeaponsPage._chosen_weapons[loadoutIndex] == desired', 1, true), "loadout selection must use native chosen state as acknowledgement")
assert(source:find('pcall(context.fireSignal, button.MouseButton1Click)', 1, true), "loadout selection must use the visible native button signal")
assert(not source:find('PickWeaponsPage:PickWeapon', 1, true), "loadout selection must not invoke PickWeapon directly")
assert(not source:find('PickWeaponsPage:Finish', 1, true), "loadout selection must not invoke Finish directly")
assert(not source:find('elseif loadoutIndex == #loadoutPlan', 1, true), "loadout picker must not report submission before native acknowledgement")

print("rivals-loadout-picker-contracts-ok")
